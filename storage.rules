rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Файлы приглашений: читают все (гости), пишут/удаляют только админы
    match /invitations/{inviteId}/{allPaths=**} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    function isAdmin() {
      return request.auth != null
          && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }
  }
}